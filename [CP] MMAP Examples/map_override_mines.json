    {
      "Action": "Load",
      "Target": "Maps/{{ModId}}/Shed22",
      "FromFile": "assets/Shed2.tmx"
    },
    {
      "Action": "EditMap",
      "Target": "Maps/{{ModId}}/Shed22",
      "MapTiles": [
        {
          "Position": {
            "X": 5,
            "Y": 6
          },
          "Layer": "Back",
          "SetProperties": {
            "mushymato.MMAP_MapOverrideSpawn": "Grass frostGrass"
          },
        },
        {
          "Position": {
            "X": 6,
            "Y": 6
          },
          "Layer": "Back",
          "SetProperties": {
            "mushymato.MMAP_MapOverrideSpawn": "Object (BC)149"
          },
        },
        {
          "Position": {
            "X": 7,
            "Y": 6
          },
          "Layer": "Back",
          "SetProperties": {
            "mushymato.MMAP_MapOverrideSpawn": "Grass cobweb"
          },
        },
        {
          "Position": {
            "X": 8,
            "Y": 6
          },
          "Layer": "Back",
          "SetProperties": {
            "mushymato.MMAP_MapOverrideSpawn": "Forage (O)16"
          },
        },
        {
          "Position": {
            "X": 9,
            "Y": 6
          },
          "Layer": "Back",
          "SetProperties": {
            "mushymato.MMAP_MapOverrideSpawn": "Object (O)6"
          },
        },
      ]
    },
    {
      "Action": "EditData",
      "Target": "mushymato.MMAP/MapOverrides",
      "Entries": {
        // debug action mushymato.MMAP_UpdateMapOverride Here + mushymato.MMAP.Example_Shed2
        "{{ModId}}_Shed2": {
          "Id": "{{ModId}}_Shed2",
          "ResizeMapIfNeeded": true,
          "SourceMap": "Maps/{{ModId}}/Shed22",
          "MapOverrideSpawnOnApply": true,
          "TargetRect": {
            "X": 10,
            "Y": 10,
            "Width": 35,
            "Height": 35
          }
        }
      }
    },
    {
      "Action": "EditData",
      "Target": "Data/TriggerActions",
      "Entries": {
        "{{ModId}}_Shed2_InMines": {
          "Id": "{{ModId}}_Shed2_InMines",
          "Trigger": "LocationChanged",
          "Condition": "mushymato.MMAP_TILESHEET_NAME Here mine Maps/Mines/mine",
          "Actions": [
            "mushymato.MMAP_UpdateMapOverride Here + mushymato.MMAP.Example_Shed2",
            "mushymato.MMAP_SetTilesheet Here mine Maps/Mines/mine_slime"
          ],
          "MarkActionApplied": false
        },
      },
    }
  ]
}
